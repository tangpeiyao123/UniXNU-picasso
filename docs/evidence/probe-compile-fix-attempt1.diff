diff --git a/patches/picasso-usb-console-xnu.patch b/patches/picasso-usb-console-xnu.patch
index de72163..1e3eb81 100644
--- a/patches/picasso-usb-console-xnu.patch
+++ b/patches/picasso-usb-console-xnu.patch
@@ -14,7 +14,7 @@ diff --git a/bsd/dev/picasso_usb.c b/bsd/dev/picasso_usb.c
 new file mode 100644
 --- /dev/null
 +++ b/bsd/dev/picasso_usb.c
-@@ -0,0 +1,3325 @@
+@@ -0,0 +1,3321 @@
 +/* Picasso USB debug console: CDC-ACM log streaming over DWC3.
 + *
 + * Port of the vermeer (ios-vermeer-lab) USB bring-up to the UniXNU Darwin 23
@@ -2333,21 +2333,17 @@ new file mode 100644
 +{
 +	proc_t p = proc_find(pid);
 +	task_t task;
-+	thread_t t;
-+	int n = 0;
-+	if (p == PROC_NULL) {
++	if (p == NULL) {
 +		printf("PICASSO_THREADS pid=%d absent\n", pid);
 +		return;
 +	}
 +	task = proc_task(p);
-+	printf("PICASSO_THREADS begin pid=%d\n", pid);
-+	queue_iterate(&task->threads, t, thread_t, task_threads) {
-+		printf("PICASSO_THREADS t=%d tid=%d state=%d pri=%d ss=%d cont=%p\n",
-+		    n++, thread_tid(t), (int)t->state, (int)t->priority,
-+		    t->machine.saved_state != NULL, (void *)t->continuation);
-+		if (n >= 96) break;
-+	}
-+	printf("PICASSO_THREADS end count=%d\n", n);
++	/* Exported headers expose only forward declarations of struct task/thread,
++	 * so per-thread fields (state/priority/saved_state/continuation) are not
++	 * accessible in this translation unit. Emit a reachability marker instead:/r/n+	 * this still proves threads/kthreads is wired up in a STALL window. */
++	printf("PICASSO_THREADS pid=%d reachable proc=%p task=%p minimal\n",
++	    pid, (void *)p, (void *)task);
++	printf("PICASSO_THREADS end pid=%d\n", pid);
 +	proc_rele(p);
 +}
